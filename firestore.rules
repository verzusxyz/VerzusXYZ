rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isOwner(userId);
    }

    // Wallets
    match /wallets/{userId} {
      allow read, write: if isOwner(userId);

      // Users can't directly modify their balance
      allow update: if isOwner(userId) && !request.resource.data.keys().hasAny(['balance']);
    }

    // Wallet transactions
    match /wallet_transactions/{transactionId} {
      allow read, write: if isOwner(get(/databases/$(database)/documents/wallet_transactions/$(transactionId)).data.user_id);
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.creator_id);
      allow update: if isOwner(resource.data.creator_id) || isOwner(resource.data.opponent_id);
      allow delete: if isOwner(resource.data.creator_id) && resource.data.status == 'pending';
    }

    // Match invitations
    match /match_invitations/{invitationId} {
      allow read, write: if isOwner(get(/databases/$(database)/documents/match_invitations/$(invitationId)).data.invited_user_id) || isOwner(get(/databases/$(database)/documents/match_invitations/$(invitationId)).data.creator_id);
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.creator_id);
      allow update: if isOwner(resource.data.creator_id);
    }

    // Tournament participants
    match /tournament_participants/{participantId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.user_id) && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournament_id)).data.status == 'open';
      allow delete: if isOwner(resource.data.user_id) && get(/databases/$(database)/documents/tournaments/$(resource.data.tournament_id)).data.status == 'open';
    }

    // Read-only collections
    match /skill_topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /leaderboard_entries/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /game_results/{resultId} {
      allow read: if isOwner(get(/databases/$(database)/documents/game_results/$(resultId)).data.player1_id) || isOwner(get(/databases/$(database)/documents/game_results/$(resultId)).data.player2_id);
      allow write: if false;
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }
  }
}