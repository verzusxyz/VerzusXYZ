rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User profile images
    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Game assets
    match /games/{gameId}/{allPaths=**} {
      allow read: if true;
    }

    // Match replays and screenshots
    match /matches/{matchId}/{fileName} {
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/matches/$(matchId)).data.creator_id == request.auth.uid ||
        firestore.get(/databases/(default)/documents/matches/$(matchId)).data.opponent_id == request.auth.uid
      );
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/matches/$(matchId)).data.creator_id == request.auth.uid ||
        firestore.get(/databases/(default)/documents/matches/$(matchId)).data.opponent_id == request.auth.uid
      );
    }

  }
}